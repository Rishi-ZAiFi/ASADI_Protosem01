# Default is fully local (no key, no internet). Options: ollama | gemini | anthropic
PROVIDER=ollama
# Optional: if the main provider fails (e.g. Gemini 503), try this one next
FALLBACK_PROVIDER=

# Ollama (local). Must be a vision model to read photos.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Gemini (free tier): key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
