# Copy this file to .env (exact name, no .txt) and fill in the key.
# Who writes the captions: gemini | ollama | anthropic
PROVIDER=gemini
# Who reads uploaded photos (leave empty to use PROVIDER)
VISION_PROVIDER=gemini
# If the main provider fails, try this one (recommended: ollama)
FALLBACK_PROVIDER=ollama

# Gemini: key from https://aistudio.google.com/apikey  (no quotes, no spaces)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama (local). gemma3:1b writes captions, gemma3:4b reads photos.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_NUM_PREDICT=900
OLLAMA_KEEP_ALIVE=30m

# auto = short prompt for local models (faster), full prompt for Gemini/Anthropic
LITE_MODE=auto

# Anthropic (optional, paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
