# ==============================================================================
# Agentic Writer's Room - Environment Variables Example
# ==============================================================================
# Copy this file to '.env' and fill in your actual API keys.
# DO NOT COMMIT your actual '.env' file to version control!

# ------------------------------------------------------------------------------
# LLM API Keys (Choose one or more based on what you plan to use)
# ------------------------------------------------------------------------------
# Google Gemini (Excellent choice! Fully supported via langchain-google-genai)
GEMINI_API_KEY="AIzaSyD_LmbW5TbRRrTQp_43XqTtmjs1OvM_LiI"

# OpenRouter (Gives access to Qwen, Claude, Llama, etc., through a single API)
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-api-key-here"

# OpenAI (Default for many LangChain/LangGraph tutorials)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Anthropic (Excellent for writing/coding tasks - Claude 3.5 Sonnet)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"

# ------------------------------------------------------------------------------
# Database Configurations (Local or Cloud)
# ------------------------------------------------------------------------------
# MongoDB Connection String (for user and project metadata)
MONGODB_URI="mongodb://localhost:27017/writers_room"

# Neo4j (For the Story Bible Knowledge Graph)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# ChromaDB / Pinecone (Vector database for RAG context)
# If using a local ChromaDB instance, this can often be left blank.
PINECONE_API_KEY="your-pinecone-api-key"
