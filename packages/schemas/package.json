{
  "name": "@contentyou/schemas",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks.d.ts",
      "default": "./dist/mocks.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "3.24.2"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "eslint": "9.20.1",
    "vitest": "3.0.5"
  },
  "dependencyNotes": {
    "typescript": "Toolchain for typechecking",
    "eslint": "Toolchain for linting",
    "vitest": "Toolchain for testing",
    "zod": "Required for schema validation"
  }
}